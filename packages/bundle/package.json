{
  "name": "dsh-scriptwriting-platform",
  "version": "0.1.0",
  "description": "Scriptwriting platform bundle: assembles core, store, tools and ui plugins",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "dsh": ">=0.2.2-0 <0.3.0" },
  "dependencies": {
    "dsh-scriptwriting-core": "workspace:^",
    "dsh-scriptwriting-store": "workspace:^",
    "dsh-scriptwriting-tools": "workspace:^",
    "dsh-scriptwriting-ui": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-storage": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage-sqlite": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-0 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-storage": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage-sqlite": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-0 <0.3.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "node ../../scripts/tsc.mjs",
    "build:dev": "node ../../scripts/tsc.mjs --mode=development",
    "dev": "node ../../scripts/tsc.mjs --watch",
    "typecheck": "tsc --noEmit"
  }
}
